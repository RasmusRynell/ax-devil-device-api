      "required": [
        "module",
        "class"
      ]
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access": {
      "enum": [
        "anonymous",
        "viewer",
        "operator",
        "admin",
        "unknown"
      ]
    },
    "discovery": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "api_discovery": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            },
            "required": [
              "api_discovery"
            ]
          },
          {
            "type": "object",
            "properties": {
              "dca": {
                "type": "object",
                "properties": {
                  "api": {
                    "type": "string"
