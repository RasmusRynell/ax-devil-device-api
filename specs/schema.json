{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax-devil.local/specs/schema.json",
  "title": "VAPIX API spec, format 2",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "section",
    "family",
    "python",
    "operations"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "format": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "family": {
      "enum": [
        "jsonrpc",
        "dca",
        "cgi",
        "service_json",
        "soap",
        "rest",
        "ws",
        "rtsp"
      ]
    },
    "status": {
      "enum": [
        "released",
        "beta",
        "alpha",
        "deprecated"
      ]
    },
    "python": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "class": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
