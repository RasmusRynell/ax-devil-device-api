          },
          {
            "type": "object",
            "properties": {
              "param": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "compare": {
                    "enum": [
                      "==",
                      ">="
                    ]
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^x-": {}
