    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/schema"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      },
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_]*$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "sha256_md": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
